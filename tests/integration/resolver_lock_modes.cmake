function(cdpm_probe_system_dependencies pkg declarations out)
    set(${out} "{\"Fake\":{\"identity\":\"${SYSTEM_ID}\"}}")
    return(PROPAGATE ${out})
endfunction()
function(cdpm_build_dependency pkg version hash meta)
    file(APPEND "${BUILD_MARKER}" "${pkg}\n")
    if(pkg STREQUAL FAIL_PACKAGE)
        message(FATAL_ERROR "intentional build failure for ${pkg}")
    endif()
    file(MAKE_DIRECTORY "${CDPM_STORE_DIR}/${pkg}/${hash}")
    file(TOUCH "${CDPM_STORE_DIR}/${pkg}/${hash}/.cdpm_installed")
endfunction()
cdpm_read_lockfile(PATH "${LOCK_PATH}")
if(ACTION STREQUAL "INIT")
    cdpm_resolve_and_build(root 1 context LOCK_MODE UPDATE)
    cdpm_resolve_and_build(later 1 context LOCK_MODE UPDATE)
elseif(ACTION STREQUAL "PROVISION")
    get_property(__lock_json GLOBAL PROPERTY CDPM_LOCKFILE_JSON)
    _cdpm_lockfile_get_roots("${__lock_json}" __roots)
    foreach(__root IN LISTS __roots)
        string(JSON __ver GET "${__lock_json}" packages "${__root}" version)
        cdpm_resolve_and_build("${__root}" "${__ver}" context LOCK_MODE VERIFY VALIDATE_ONLY)
    endforeach()
    foreach(__root IN LISTS __roots)
        string(JSON __ver GET "${__lock_json}" packages "${__root}" version)
        cdpm_resolve_and_build("${__root}" "${__ver}" context LOCK_MODE VERIFY)
    endforeach()
else()
    cdpm_resolve_and_build(root 1 context LOCK_MODE "${LOCK_MODE}")
endif()
]=])
