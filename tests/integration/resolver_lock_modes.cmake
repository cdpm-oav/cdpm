file(SHA256 "${lock}" baseline_sha)

set(ARG_MODE VERIFY)
set(ARG_ACTION RESOLVE)
run_case(success TRUE)
file(SHA256 "${lock}" success_sha)
assert_eq("${success_sha}" "${baseline_sha}" "successful VERIFY leaves lock byte-identical")

foreach(drift IN ITEMS source system_artifact system_definition)
    set(ARG_REV root-pin)
    set(ARG_SYSTEM system-one)
    if(drift STREQUAL source)
        set(ARG_REV changed-pin)
    elseif(drift STREQUAL system_artifact)
        set(ARG_SYSTEM artifact-two)
    else()
        set(ARG_SYSTEM definition-two)
    endif()
    run_case("${drift}_drift" FALSE)
    if(EXISTS "${${drift}_drift_marker}")
        message(FATAL_ERROR "FAIL: ${drift} drift reached the build")
    endif()
    file(SHA256 "${lock}" drift_sha)
    assert_eq("${drift_sha}" "${baseline_sha}" "${drift} drift leaves lock byte-identical")
endforeach()

