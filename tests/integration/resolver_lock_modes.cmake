function(run_case name expect_success)
    set(marker "${tmp}/${name}.builds")
    set(repo_load_marker "${tmp}/${name}.repos")
    file(REMOVE "${marker}")
    file(REMOVE "${repo_load_marker}")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DPROJECT_DIR=${tmp}" "-DLOCK_PATH=${ARG_LOCK}" "-DLOCK_MODE=${ARG_MODE}"
        "-DROOT_REV=${ARG_REV}" "-DSYSTEM_ID=${ARG_SYSTEM}" "-DBUILD_MARKER=${marker}"
        "-DLATER_REV=${ARG_LATER_REV}" "-DREPO_PIN=${ARG_REPO_PIN}" "-DACTION=${ARG_ACTION}"
        "-DREPO_LOAD_MARKER=${repo_load_marker}" "-DFAIL_PACKAGE=${ARG_FAIL}" -P "${runner}"
        RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expect_success AND NOT rc EQUAL 0)
        message(FATAL_ERROR "FAIL: ${name} unexpectedly failed\n${output}${error}")
    elseif(NOT expect_success AND rc EQUAL 0)
        message(FATAL_ERROR "FAIL: ${name} unexpectedly succeeded")
    endif()
    set(${name}_marker "${marker}" PARENT_SCOPE)
    set(${name}_repo_marker "${repo_load_marker}" PARENT_SCOPE)
    set(${name}_output "${output}${error}" PARENT_SCOPE)
endfunction()

set(lock "${tmp}/strict.lock.json")
